# =============================================================================
# MyCLI Server — Environment Variables
# =============================================================================
# Copy this to .env and fill in your values.
# NEVER commit .env to version control.

# --- Server ---
MYCLI_PORT=8787
MYCLI_APP_URL=http://localhost:8787
MYCLI_DB_PATH=./data/mycli.db

# --- Auth ---
MYCLI_ADMIN_TOKEN=admin

# --- Session Limits ---
MYCLI_FREE_SESSIONS_PER_DAY=6
MYCLI_SESSION_DURATION_MINUTES=60
MYCLI_SESSION_GRACE_MINUTES=10
MYCLI_SESSION_RESET_OFFSET_HOURS_UTC=-7
MYCLI_SESSION_RESET_TIMEZONE=Pacific Time

# --- Paid Tier ---
MYCLI_PAID_SESSIONS_PER_DAY=200
MYCLI_PAID_ADS_ENABLED=false
MYCLI_SUBSCRIPTION_GRACE_PERIOD_DAYS=7

# --- Model Pricing ($ per 1M tokens) ---
MYCLI_PRICE_INPUT_USD_PER_MT=0.1
MYCLI_PRICE_OUTPUT_USD_PER_MT=0.2

# --- Ads ---
MYCLI_AD_REVENUE_PER_IMPRESSION_USD=0.001
# MYCLI_AD_INVENTORY='[{"adText":"Sponsored","title":"DeepInfra","cta":"Try","url":"https://deepinfra.com","favicon":"https://deepinfra.com/favicon.ico","weight":3}]'

# --- Logging ---
MYCLI_LOG_SHIPPING=true
MYCLI_LOG_LEVEL=info

# =============================================================================
# Paddle (Merchant of Record)
# =============================================================================
# Get keys from: https://sandbox.paddle.com (sandbox) or https://live.paddle.com (production)
# NEVER commit these values. NEVER expose the API key in client-side code.

# Server-side API key (used for webhooks, checkout creation)
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# Client-side token (used for PricePreview in the browser)
# Must start with "live_" for production, "test_" for sandbox
PADDLE_CLIENT_TOKEN=

# Environment: "sandbox" or "production"
PADDLE_ENV=sandbox
