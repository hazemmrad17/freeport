# =============================================================================
# Freeport Server — Environment Variables
# =============================================================================
# Copy this to .env and fill in your values.
# NEVER commit .env to version control.

# --- Server ---
FREEPORT_PORT=8787
FREEPORT_APP_URL=http://localhost:8787
FREEPORT_DB_PATH=./data/freeport.db

# --- Auth & OAuth (GitHub & Google) ---
FREEPORT_ADMIN_TOKEN=admin
# GitHub OAuth App: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8787/api/auth/github/callback

# Google Cloud OAuth Client: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8787/api/auth/google/callback

# --- Anti-Abuse & Trust Tiers ---
FREEPORT_LOW_TRUST_FREE_SESSIONS_PER_DAY=1
FREEPORT_MAX_SIGNUPS_PER_IP_24H=3

# --- Session Limits (plan structure) ---
# Public Utility (free): 3 active sessions/day, $0.05/day hard spend cap
FREEPORT_FREE_SESSIONS_PER_DAY=3
FREEPORT_FREE_DAILY_SPEND_CAP_USD=0.05
# Pro Supporter (paid): 6 active sessions/day, ad-free
FREEPORT_PAID_SESSIONS_PER_DAY=6
FREEPORT_PAID_ADS_ENABLED=false
FREEPORT_SUBSCRIPTION_GRACE_PERIOD_DAYS=7

# Session shape (all tiers)
FREEPORT_SESSION_DURATION_MINUTES=60
FREEPORT_SESSION_GRACE_MINUTES=10
FREEPORT_SESSION_RESET_OFFSET_HOURS_UTC=-7
FREEPORT_SESSION_RESET_TIMEZONE=Pacific Time

# --- Model Pricing ($ per 1M tokens, DeepInfra DeepSeek V4 Flash) ---
FREEPORT_PRICE_INPUT_USD_PER_MT=0.1
FREEPORT_PRICE_OUTPUT_USD_PER_MT=0.2

# --- Ads ---
FREEPORT_AD_REVENUE_PER_IMPRESSION_USD=0.001
# FREEPORT_AD_INVENTORY='[{"adText":"Sponsored","title":"DeepInfra","cta":"Try","url":"https://deepinfra.com","favicon":"https://deepinfra.com/favicon.ico","weight":3}]'

# --- Logging ---
FREEPORT_LOG_SHIPPING=true
FREEPORT_LOG_LEVEL=info

# =============================================================================
# Paddle (Merchant of Record) — sandbox first, then live
# =============================================================================
# Sandbox dashboard: https://sandbox.paddle.com
# Live dashboard:    https://live.paddle.com
# NEVER commit these values. NEVER put the server API key in client code.

# Server-side API key (webhooks, checkout creation) — pdl_sdbx_... / pdl_live_...
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# Client-side token for the pricing page — test_... (sandbox) / live_... (production)
PADDLE_CLIENT_TOKEN=

# "sandbox" or "production" — never silently default; set it explicitly
PADDLE_ENV=sandbox
